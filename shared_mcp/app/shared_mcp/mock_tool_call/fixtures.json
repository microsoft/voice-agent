  "articles": [
    {
      "id": 360001,
      "title": "Reset your password or re-register MFA",
      "body": "Go to passwordreset.contoso.com, verify with your registered phone or authenticator app, and choose a new password. The same page re-registers multi-factor authentication (MFA) when you change phones. Support never asks for your password.",
      "labels": ["password", "locked out", "mfa", "sign in", "forgot password", "account"]
    },
    {
      "id": 360002,
      "title": "Fix 'authentication failed' in the GlobalProtect VPN client",
      "body": "1. Sign out of GlobalProtect and sign in again with your full work email. 2. Confirm your password works at myapps.contoso.com. 3. Remove the saved portal and add vpn.contoso.com again. 4. If it still fails, restart the computer and try once more before contacting IT.",
      "labels": ["vpn", "globalprotect", "authentication failed", "remote", "work from home"]
    },
    {
      "id": 360003,
      "title": "Troubleshoot data sync failures",
      "body": "1. Check the sync status page in Settings > Sync for the last error. 2. Reconnect the data source with a fresh sign-in. 3. Make sure the source table has fewer than 1 million changed rows per run. 4. Run a manual sync and wait 10 minutes before checking again.",
      "labels": ["sync", "data", "pipeline", "connector", "fails", "error"]
    },
    {
      "id": 360004,
      "title": "API returns 401 Unauthorized",
      "body": "A 401 means the API key or token is missing, expired, or rotated. 1. Create a new API key under Settings > API keys. 2. Send it in the Authorization header as 'Bearer <key>'. 3. Keys rotate every 90 days; update every integration after a rotation.",
      "labels": ["api", "401", "unauthorized", "token", "key", "integration"]
    },
    {
      "id": 360005,
      "title": "Install approved software from Company Portal",
      "body": "Open the Company Portal app, search for the application, and select Install. Software that is not listed needs IT management approval through a ticket.",
      "labels": ["software", "install", "company portal", "application", "app"]
    },
    {
      "id": 360006,
      "title": "External monitor flickers or shows no signal",
      "body": "1. Reseat both ends of the cable or try another port. 2. Update the display driver from Company Portal. 3. Lower the refresh rate to 60 Hz in Display settings. 4. Test with a different cable before asking for a replacement.",
      "labels": ["monitor", "display", "flicker", "flickering", "screen", "no signal", "hardware"]
    },
    {
      "id": 360007,
      "title": "Submit an expense report",
      "body": "Open Expenses on the intranet, attach a photo of each receipt, and submit within 30 days of the purchase. Your manager approves the report, and reimbursement arrives with the next payroll.",
      "labels": ["expense", "receipt", "reimbursement", "finance"]
    },
    {
      "id": 360008,
      "title": "Request paid time off",
      "body": "Request PTO in the HR portal under Time Off at least two weeks ahead for more than three days. Your manager approves it. Exceptions to the PTO policy go to your HR people partner.",
      "labels": ["pto", "vacation", "time off", "leave", "holiday", "hr"]
    },
    {
      "id": 360009,
      "title": "Connect to office Wi-Fi",
      "body": "Choose the Contoso-Corp network and sign in with your work email and password. Guests use Contoso-Guest with the daily code from reception.",
      "labels": ["wifi", "wi-fi", "wireless", "network", "internet", "office"]
    },
    {
      "id": 360010,
      "title": "Set up multi-factor authentication",
      "body": "Install Microsoft Authenticator, open myapps.contoso.com > Security info, and add the app by scanning the QR code. Keep a phone number as a backup method.",
      "labels": ["mfa", "authenticator", "two-factor", "security", "sign in"]
    }
  ],
