{
  "name": "example37_smart_home_appliance_agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "tsx tests/live.ts",
    "agents:render": "tsx server/sync-agent-config.ts",
    "agents:publish": "tsx server/sync-agent-config.ts --publish",
    "lab:webrtc": "tsx server/webrtc-benchmark.ts",
    "format": "prettier --write src shared server tests agents knowledge/*.json webrtc-benchmark/*.html deploy/*.mjs *.json *.ts *.html *.md deploy/*.md",
    "format:check": "prettier --check src shared server tests agents knowledge/*.json webrtc-benchmark/*.html deploy/*.mjs *.json *.ts *.html *.md deploy/*.md",
    "lint": "tsc --noEmit && npm run format:check"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "vite": "^7.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
