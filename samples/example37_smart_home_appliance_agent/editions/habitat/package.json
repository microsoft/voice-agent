{
  "name": "smart-home-habitat",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 5184 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "format": "prettier --write src tests *.ts *.json *.html README.md",
    "format:check": "prettier --check src tests *.ts *.json *.html README.md"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
