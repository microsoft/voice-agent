# Copy to .env and replace placeholders. Never commit the populated file.
# Local offline/manual controls work with these Foundry fields left unset.
FOUNDRY_PROJECT_ENDPOINT=
SMART_HOME_FLASH_AGENT=REPLACE_WITH_FLASH_AGENT_NAME
SMART_HOME_REALTIME_AGENT=REPLACE_WITH_REALTIME_AGENT_NAME
# Set to microsoft-realtime-flash-1 only after checking your own Flash Agent.
SMART_HOME_VERIFIED_MODELS=
# Optional local Azure CLI tenant or cloud user-assigned managed identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
HOST=127.0.0.1
PORT=5178
# Cloud settings are intentionally disabled. HTTPS, persistent storage and
# new random secrets are required; do not expose Vite on a shared network.
SMART_HOME_PUBLIC_ORIGIN=
SMART_HOME_PUBLIC_GUEST_ACCESS=0
SMART_HOME_ACCESS_CODE=
SMART_HOME_SESSION_SECRET=
SMART_HOME_DATA_PATH=
SMART_HOME_WEB_ROOT=dist
# Optional Voice Live model-mode WebRTC latency lab; not a Voice Agent endpoint.
VOICE_LIVE_ENDPOINT=
WEBRTC_MODEL=microsoft-realtime-flash-1
