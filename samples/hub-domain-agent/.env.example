# Existing project and text-model deployment; no resources/models are provisioned.
PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
MODEL_DEPLOYMENT=gpt-5.4-mini
# Build/push the image first, then use an immutable linux/amd64 runtime digest.
HUB_AGENT_IMAGE=YOUR-REGISTRY.azurecr.io/hub-agent@sha256:REPLACE-WITH-64-HEX-DIGEST
BILLING_AGENT_IMAGE=YOUR-REGISTRY.azurecr.io/billing-agent@sha256:REPLACE-WITH-64-HEX-DIGEST
BOOKING_AGENT_IMAGE=YOUR-REGISTRY.azurecr.io/booking-agent@sha256:REPLACE-WITH-64-HEX-DIGEST
AGENT_PREFIX=hub-domain-demo
IDLE_TIMEOUT_SECONDS=120
DOMAIN_MODEL_WARMUP=true
