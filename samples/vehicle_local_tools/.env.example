AZURE_VOICE_AGENTS_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_VOICE_AGENTS_MODEL=gpt-realtime
AZURE_VOICE_AGENTS_VOICE=en-US-AvaNeural
AZURE_CREDENTIAL_MODE=cli
# Public hosting uses managed_identity and AZURE_CLIENT_ID, never a copied CLI login.
# PUBLIC_ORIGIN=https://your-app.azurewebsites.net
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# AZURE_VOICE_AGENT_NAME=<pre-provisioned-agent-name>
# VOICE_SESSION_SECONDS=300
# VOICE_STARTS_PER_DAY=20
# DEMO_USAGE_DB=/home/data/vehicle-demo/usage.sqlite3
# Optional public-fact grounding. Enter a rotated key directly in protected settings.
WEBIQ_ENABLED=false
# WEBIQ_API_KEY=<protected-replacement-key>
